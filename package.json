{
  "name": "local-llm-mcp",
  "version": "1.0.0",
  "description": "Streamable HTTP MCP server for the local LLM gateway",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "build": "tsc",
    "start:prod": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx test/index.ts"
  },
  "keywords": ["mcp", "fastmcp", "llm"],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "fastmcp": "^4.12.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
