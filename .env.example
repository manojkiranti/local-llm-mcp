# Required shared secret. Use the exact same value for the gateway MCP_AUTH_TOKEN.
MCP_SERVICE_TOKEN=replace-with-a-long-random-secret

# Streamable HTTP listener. The MCP endpoint is always /mcp.
PORT=3333
HOST=127.0.0.1

# Optional. When set, the HRMS tools fetch the live active-employee feed
# instead of returning sample data. The feed returns every active employee on
# each request (no server-side filter/paging), so the tools filter and
# paginate the results themselves.
# HRMS_BASE_URL=http://10.14.14.121:2080/api/v1/auth/employees/active-employee

# Optional. Set only if the HRMS endpoint requires NTLM (Windows) auth. When
# unset, requests are sent as plain unauthenticated GETs.
# HRMS_NTLM_USERNAME=
# HRMS_NTLM_PASSWORD=
# HRMS_NTLM_DOMAIN=
# HRMS_NTLM_WORKSTATION=

# Optional. When set, the iZone (on-prem SharePoint) tools fetch the live
# site instead of returning sample data. The site requires NTLM auth on every
# request, so IZONE_NTLM_USERNAME/PASSWORD are required whenever this is set.
# IZONE_BASE_URL=http://izone3.nicasiabank.com/
# IZONE_NTLM_USERNAME=
# IZONE_NTLM_PASSWORD=
# IZONE_NTLM_DOMAIN=
# IZONE_NTLM_WORKSTATION=

# Optional. When set, search_izone_country_circulars fetches the live Country
# Circular index instead of returning sample data. This is a separate internal
# API (not SharePoint's REST API, no auth) that the "Search Country Circular"
# page's own JavaScript calls; it always returns the full index, so the tool
# filters/paginates it itself.
# IZONE_COUNTRY_CIRCULAR_URL=http://10.10.0.203/SharepointAPI/api/spList/LoadCountryCircular

# Optional. When all of EMS_DB_HOST/EMS_DB_NAME/EMS_DB_USER are set, the EMS
# (Expenses Management System) tools query the live MySQL database instead of
# returning sample data. Use a read-only MySQL account if possible — the
# tools also enforce read-only (single SELECT statement only) at the
# application layer regardless.
# EMS_DB_HOST=
# EMS_DB_PORT=3306
# EMS_DB_NAME=
# EMS_DB_USER=
# EMS_DB_PASSWORD=
# EMS_DB_SSL=false
# EMS_DB_CONNECTION_LIMIT=5
