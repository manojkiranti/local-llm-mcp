# Required shared secret. Use the exact same value for the gateway MCP_AUTH_TOKEN.
MCP_SERVICE_TOKEN=replace-with-a-long-random-secret

# Streamable HTTP listener. The MCP endpoint is always /mcp.
PORT=3333
HOST=127.0.0.1

# Optional. When set, list_hrms_employees fetches the live active-employee OData
# feed instead of returning sample data. The endpoint is network-trusted, so no
# auth header is sent — reach it only over a private network.
# HRMS_BASE_URL=http://10.10.157.30:21080/api/v1/auth/employees/active-employee
